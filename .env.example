# Grok AI Trading Team settings (simulation only)
# 1. Copy this file and rename the copy to:  .env
# 2. Fill in what you want. Everything is optional.
# NEVER share your .env file or post your API key anywhere.

# --- Grok (optional, research only) ---
# Get a key at https://console.x.ai  (leave blank to run as an offline demo)
# Grok never places orders or changes risk limits. It is only called when you press
# "Test connection" or "Run Grok research" on the dashboard (Agents tab).
XAI_API_KEY=
# A model id listed at https://docs.x.ai/developers/models
XAI_MODEL=grok-4.3
# Automatic Grok research every N seconds (minimum 300). 0 = off. Every run costs money.
GROK_AUTO_RESEARCH_SECONDS=0

# --- Real US stock data (optional) ---
# Free key: https://www.alphavantage.co/support/#api-key  (free tier: 25 requests per day)
# Only used by `python -m app.stockdata fetch ...`, which you run yourself. Leave blank and import a CSV instead.
ALPHAVANTAGE_API_KEY=

# --- Simulated account ---
STARTING_CASH=100000
WATCHLIST=SPY,QQQ,AAPL,NVDA,TSLA,BTC-USD,ETH-USD,SOL-USD,PM-FED-CUT-DEC,PM-BTC-100K-EOY
# Start with human approval ON (you can also toggle it on the dashboard)
REQUIRE_APPROVAL=false

# --- Risk rules (enforced by the Risk Manager) ---
MAX_POSITION_PCT=0.15
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_CRYPTO_EXPOSURE_PCT=0.30
REVIEW_BELOW_CONFIDENCE=0.55
FEE_PCT=0.001
# Lesson 10 (decision engine). Total cap default = MAX_OPEN_POSITIONS x MAX_POSITION_PCT.
MAX_TOTAL_EXPOSURE_PCT=0.75
RISK_PER_TRADE_PCT=0.01
SLIPPAGE_PCT=0.001
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_HOURS=24

# --- System ---
CYCLE_SECONDS=5
PORT=8000
